# Copy to .env in BACKEND and replace placeholders with your Supabase project values.
# Use a publishable/anon key only. Never use a service_role/secret key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Optional compatibility alias. If both are set, they must contain the same public key.
# SUPABASE_API_KEY=your-supabase-publishable-or-anon-key

# Optional server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=18080

# Comma-separated exact origins. These defaults serve common local frontend dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# Staging-only opt-in after create_borrow_request is deployed and verified.
# When false, borrow-request submission returns 503; no direct-write path exists.
# RPC failures never fall back to direct writes.
SUPABASE_RPC_CREATE_BORROW_REQUEST=false

# Staging-only opt-in after the proposal SQL is approved, installed and verified.
# The false default preserves the current direct PATCH path.
SUPABASE_RPC_ATOMIC_RESOURCE_UPDATE=false

# Staging-only status actions require the atomic resource RPC too, after the
# availability_status direct UPDATE grant is removed and staging tests pass.
SUPABASE_RPC_BORROW_STATUS=false

# Staging-only marketplace routes (Task 12 migration and coordinated cutover).
# Keep false until migration review and two-account staging validation succeed.
SUPABASE_MARKETPLACE_ENABLED=false
SUPABASE_RESOURCE_IMAGES_ENABLED=false
