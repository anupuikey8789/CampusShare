# Copy to .env in BACKEND and replace placeholders with your Supabase project values.
# Use a publishable/anon key only. Never use a service_role/secret key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=18080

# Comma-separated exact origins. These defaults serve common local frontend dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
